---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { loadCatalog, loadMilestoneFields, summaryEntryId } from "../../lib/catalog";

// The milestone paths: every library paper carrying a milestone block, grouped by
// field (config/milestones.yaml via registry/milestones.json), ordered era -> year.
const ERA_ORDER: Record<string, number> = { emergence: 0, foundational: 1, expansion: 2, recent: 3 };
const ERAS = ["emergence", "foundational", "expansion", "recent"];

const sums = await getCollection("summaries");
const dateById = new Map(sums.map((e) => [e.id.toLowerCase(), (e.data as any).summary_date ?? null]));

const cat = loadCatalog();
const meta = loadMilestoneFields();
const base = import.meta.env.BASE_URL;

type Row = {
  key: string; title: string; year: number | null; venue: string | null;
  era: string; subarea: string | null; significance: string;
  href: string | null; external: boolean; hasSummary: boolean; marker: string;
};

const byField = new Map<string, Row[]>();
for (const p of cat) {
  const m = p.milestone;
  if (!m?.field) continue;
  const id = summaryEntryId(p.summary_path);
  const summaryDate = id ? (dateById.get(id) ?? null) : null;
  const hasSummary = !!p.summary_path && summaryDate !== null;
  const row: Row = {
    key: p.canonical_key,
    title: p.title,
    year: p.year,
    venue: p.venue,
    era: m.era ?? "foundational",
    subarea: m.subarea ?? null,
    significance: m.significance ?? "",
    href: hasSummary
      ? `${base}papers/${p.canonical_key}/`.replace(/\/+/g, "/")
      : (p.source_link ?? null),
    external: !hasSummary,
    hasSummary,
    marker: `${p.latest_version ?? "v?"}__${summaryDate ?? ""}`,
  };
  if (!byField.has(m.field)) byField.set(m.field, []);
  byField.get(m.field)!.push(row);
}

const fields = Array.from(byField.keys()).sort((a, b) => {
  const oa = meta[a]?.path_order ?? 99;
  const ob = meta[b]?.path_order ?? 99;
  return oa - ob || a.localeCompare(b);
});

function eraGroups(rows: Row[]) {
  const sorted = [...rows].sort(
    (a, b) =>
      (ERA_ORDER[a.era] ?? 9) - (ERA_ORDER[b.era] ?? 9) ||
      (a.year ?? 0) - (b.year ?? 0) ||
      a.title.localeCompare(b.title),
  );
  return ERAS.map((era) => {
    const items = sorted.filter((r) => r.era === era);
    const years = items.map((r) => r.year).filter((y): y is number => !!y);
    const span = years.length
      ? Math.min(...years) === Math.max(...years)
        ? `${years[0]}`
        : `${Math.min(...years)}–${Math.max(...years)}`
      : "";
    return { era, span, items };
  }).filter((g) => g.items.length);
}

const displayName = (f: string) => meta[f]?.display_name ?? f.replace(/_/g, " ");
const total = fields.reduce((n, f) => n + byField.get(f)!.length, 0);

// Subarea lanes per field (for the filter chips); only shown when a field has >= 2 lanes.
function lanes(rows: Row[]) {
  const counts = new Map<string, number>();
  for (const r of rows) if (r.subarea) counts.set(r.subarea, (counts.get(r.subarea) ?? 0) + 1);
  return Array.from(counts.entries())
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .map(([name, n]) => ({ name, n }));
}
---
<Base title="Milestone Paths — Paper Library">
  <h1 class="title">Milestone Paths</h1>
  <p class="count">
    {total} landmark papers across {fields.length} fields, from each field's emergence to today.
    Pick a field, then follow its path top-to-bottom; ✓ marks what you've read,
    ↗ opens the source of a paper whose summary is still pending.
  </p>

  <div class="tabs" role="tablist" aria-label="fields">
    {fields.map((f, i) => (
      <button
        class:list={["tab", { active: i === 0 }]}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        data-tab={f}
      >
        {displayName(f)} <span class="n">{byField.get(f)!.length}</span>
      </button>
    ))}
  </div>

  {fields.map((f, i) => {
    const rows = byField.get(f)!;
    const withSummary = rows.filter((r) => r.hasSummary).length;
    const fieldLanes = lanes(rows);
    return (
      <section
        class:list={["path", { active: i === 0 }]}
        id={f}
        data-field={f}
        role="tabpanel"
        aria-label={displayName(f)}
      >
        <header class="path-head">
          <h2>{displayName(f)}</h2>
          <p class="desc">{meta[f]?.description}</p>
          <div class="stat-strip">
            <div class="stat read"><b data-stat-for={f}>0</b><span>read</span></div>
            <div class="stat"><b>{withSummary}</b><span>summarized</span></div>
            <div class="stat"><b>{rows.length}</b><span>papers</span></div>
          </div>
          <div class="bar" role="presentation"><div class="fill" data-bar-for={f}></div></div>
          {fieldLanes.length >= 2 && (
            <div class="lanes" role="group" aria-label="filter by sub-area">
              <button class="lane-chip active" data-lane="">all <span class="n">{rows.length}</span></button>
              {fieldLanes.map((l) => (
                <button class="lane-chip" data-lane={l.name}>
                  {l.name.replace(/_/g, " ")} <span class="n">{l.n}</span>
                </button>
              ))}
            </div>
          )}
        </header>
        {eraGroups(rows).map((g) => (
          <div class="era">
            <h3>
              <span class="era-ord">{["I", "II", "III", "IV"][ERAS.indexOf(g.era)]}</span>
              <span class="era-name">{g.era}</span>
              {g.span && <span class="era-span">{g.span}</span>}
              <span class="era-n">{g.items.length} papers</span>
            </h3>
            <ol class="steps">
              {g.items.map((r) => (
                <li
                  class:list={["step", { "no-summary": !r.hasSummary }]}
                  data-key={r.key}
                  data-marker={r.marker}
                  data-summarized={r.hasSummary ? "1" : "0"}
                  data-subarea={r.subarea ?? ""}
                >
                  <span class="dot" aria-hidden="true"></span>
                  <span class="yr">{r.year ?? "—"}</span>
                  <span class="body">
                    {r.href ? (
                      <a href={r.href} rel={r.external ? "noopener" : undefined}>{r.title}</a>
                    ) : (
                      <span class="t">{r.title}</span>
                    )}
                    {r.subarea && <span class="lane">{r.subarea.replace(/_/g, " ")}</span>}
                    <span class="sig">{r.significance}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    );
  })}
</Base>

<script>
  // Decorate read state from the reading tracker's local cache (see lib/reads.ts):
  // a step is "read" when the stored marker matches the current version+summary-date.
  let reads: Record<string, string> = {};
  try { reads = JSON.parse(localStorage.getItem("paper-reads") || "{}"); } catch { /* ignore */ }
  const counts: Record<string, { read: number; summarized: number }> = {};
  document.querySelectorAll<HTMLElement>(".step").forEach((el) => {
    const field = el.closest<HTMLElement>(".path")?.dataset.field;
    if (!field) return;
    counts[field] ??= { read: 0, summarized: 0 };
    if (el.dataset.summarized === "1") {
      counts[field].summarized++;
      if (reads[el.dataset.key || ""] === el.dataset.marker) {
        el.classList.add("is-read");
        counts[field].read++;
      }
    }
  });
  for (const [field, c] of Object.entries(counts)) {
    const stat = document.querySelector<HTMLElement>(`[data-stat-for="${field}"]`);
    if (stat) stat.textContent = String(c.read);
    const bar = document.querySelector<HTMLElement>(`[data-bar-for="${field}"]`);
    if (bar) bar.style.width = c.summarized ? `${(100 * c.read) / c.summarized}%` : "0";
  }

  // Horizontal field tabs: one path visible at a time. Deep-link via #hash;
  // the last choice is remembered per browser.
  const bar = document.querySelector<HTMLElement>(".tabs");
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".tab"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".path"));
  const barTop = bar ? bar.getBoundingClientRect().top + window.scrollY : 0;
  const hasField = (f: string) => panels.some((p) => p.dataset.field === f);
  function activate(field: string, scroll: boolean) {
    if (!hasField(field)) return;
    tabs.forEach((t) => {
      const on = t.dataset.tab === field;
      t.classList.toggle("active", on);
      t.setAttribute("aria-selected", on ? "true" : "false");
    });
    panels.forEach((p) => p.classList.toggle("active", p.dataset.field === field));
    history.replaceState(null, "", `#${field}`);
    try { localStorage.setItem("milestone-tab", field); } catch { /* ignore */ }
    if (scroll && window.scrollY > barTop) window.scrollTo({ top: barTop });
  }
  tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab || "", true)));
  let initial = location.hash.slice(1);
  if (!hasField(initial)) {
    try { initial = localStorage.getItem("milestone-tab") || ""; } catch { initial = ""; }
  }
  if (hasField(initial)) activate(initial, false);

  // Sub-area filter chips: show only the selected lane's steps; hide eras left empty.
  document.querySelectorAll<HTMLElement>(".path").forEach((section) => {
    const chips = section.querySelectorAll<HTMLButtonElement>(".lane-chip");
    if (!chips.length) return;
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.classList.toggle("active", c === chip));
        const lane = chip.dataset.lane ?? "";
        section.querySelectorAll<HTMLElement>(".step").forEach((el) => {
          el.style.display = !lane || el.dataset.subarea === lane ? "" : "none";
        });
        section.querySelectorAll<HTMLElement>(".era").forEach((era) => {
          const any = Array.from(era.querySelectorAll<HTMLElement>(".step")).some(
            (el) => el.style.display !== "none",
          );
          era.style.display = any ? "" : "none";
        });
      }),
    );
  });
</script>

<style>
  .count { font-size: .95rem; line-height: 1.6; max-width: 68ch; }

  /* --- field tabs --------------------------------------------------------- */
  .tabs {
    position: sticky; top: 0; z-index: 5;
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    display: flex; gap: .15rem; overflow-x: auto;
    margin: 1.3rem 0 2rem; border-bottom: 1px solid var(--line);
  }
  .tab {
    font-family: var(--font-body); font-size: .92rem; color: var(--mut);
    background: none; border: none; border-bottom: 2px solid transparent;
    padding: .6rem .95rem; cursor: pointer; white-space: nowrap;
    transition: color .15s;
  }
  .tab:hover { color: var(--ink); }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
  .tab .n { font-size: .74rem; margin-left: .2rem; font-weight: 400; opacity: .7; }

  /* --- one path at a time; eras rise in as a staggered reveal ------------- */
  .path { display: none; margin: 0 0 3.5rem; }
  .path.active { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .path.active .path-head { animation: rise .35s ease both; }
    .path.active .era { animation: rise .45s ease both; }
    .path.active .era:nth-of-type(1) { animation-delay: .06s; }
    .path.active .era:nth-of-type(2) { animation-delay: .14s; }
    .path.active .era:nth-of-type(3) { animation-delay: .22s; }
    .path.active .era:nth-of-type(4) { animation-delay: .3s; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* --- chapter-style path header ------------------------------------------ */
  .path-head { margin: 0 0 1.4rem; }
  .path-head h2 {
    font-family: var(--font-display); font-weight: 600; font-size: 1.75rem;
    letter-spacing: -.01em; margin: 0 0 .45rem;
  }
  .path-head .desc {
    color: var(--mut); font-size: 1.02rem; line-height: 1.55;
    margin: 0 0 1.1rem; max-width: 62ch;
  }
  .stat-strip { display: flex; align-items: flex-end; gap: 1.7rem; margin: 0 0 .55rem; }
  .stat { display: flex; flex-direction: column; gap: .1rem; }
  .stat b {
    font-size: 1.3rem; font-weight: 600; color: var(--ink); line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .stat.read b { color: var(--accent); }
  .stat span { font-size: .72rem; color: var(--mut); font-variant: all-small-caps; letter-spacing: .09em; }
  .bar { height: 4px; background: var(--soft); border-radius: 3px; max-width: 24rem; margin-bottom: 1.2rem; }
  .bar .fill { height: 100%; width: 0; background: var(--accent); border-radius: 3px; transition: width .4s ease; }

  /* --- sub-area lane filter ------------------------------------------------ */
  .lanes { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0 0 .3rem; }
  .lane-chip {
    font-family: var(--font-body); font-size: .78rem; color: var(--mut);
    background: none; border: 1px solid var(--line); border-radius: 999px;
    padding: .18rem .7rem; cursor: pointer; transition: color .15s, border-color .15s;
  }
  .lane-chip:hover { border-color: var(--accent); color: var(--ink); }
  .lane-chip.active {
    color: var(--accent); border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .lane-chip .n { opacity: .6; font-size: .7rem; }

  /* --- era waypoints -------------------------------------------------------- */
  .era h3 {
    display: flex; align-items: baseline; gap: .6rem;
    font-size: .95rem; margin: 1.8rem 0 .7rem;
  }
  .era-ord { font-family: var(--font-display); font-size: .92rem; font-weight: 500; color: var(--mut); }
  .era-name { font-variant: all-small-caps; letter-spacing: .14em; color: var(--accent); font-weight: 600; }
  .era-span { color: var(--mut); font-size: .82rem; font-weight: 400; font-variant-numeric: tabular-nums; }
  .era-n { color: var(--mut); font-size: .78rem; font-weight: 400; font-variant: all-small-caps; letter-spacing: .06em; }
  .era h3::after {
    content: ""; flex: 1; height: 1px; align-self: center; margin-left: .4rem;
    background: linear-gradient(to right, var(--line), transparent);
  }

  /* --- the path: spine, waypoint dots, reading-size entries ---------------- */
  .steps { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--line); }
  .step {
    position: relative; display: flex; gap: .8rem;
    padding: .5rem .6rem .5rem 1.25rem; border-radius: 0 8px 8px 0;
    transition: background .15s;
  }
  .step:hover { background: var(--soft); }
  .step .dot {
    position: absolute; left: -6px; top: 1.02rem; width: 10px; height: 10px;
    border-radius: 50%; background: var(--paper); border: 2px solid var(--mut); box-sizing: border-box;
  }
  .step.is-read .dot { background: var(--accent); border-color: var(--accent); }
  .step.no-summary .dot { opacity: .45; }
  .step.is-read .body > a::after { content: " ✓"; color: var(--accent); }
  .yr {
    font-family: var(--font-body); font-size: .86rem; color: var(--mut);
    min-width: 3.1em; text-align: right; padding-top: .26em; font-variant-numeric: tabular-nums;
  }
  .body { flex: 1; font-size: 1.05rem; line-height: 1.5; }
  .body a, .body .t { font-family: var(--font-display); font-weight: 500; text-decoration: none; }
  .body a:hover { text-decoration: underline; }
  .step.no-summary .body a, .step.no-summary .t { color: var(--ink); }
  .step.no-summary .body a::after { content: " ↗"; font-size: .78em; opacity: .75; }
  .lane {
    font-size: .74rem; font-family: var(--font-body); font-weight: 400; color: var(--mut);
    background: var(--soft); border-radius: 999px; padding: .06em .6em;
    margin-left: .55em; white-space: nowrap; vertical-align: .18em;
  }
  .sig {
    display: block; color: var(--mut); font-size: .92rem; line-height: 1.5;
    max-width: 72ch; margin-top: .12rem;
  }
</style>
